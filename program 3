#include <stdio.h>
int main()
{
    int n = 10, a = 0, b = 1, c, i = 3;
    if(n == 1)
        printf("%d", a);
    else if(n == 2)
        printf("%d", b);
    else
    {
        while(i <= n)
        {
            c = a + b;
            a = b;
            b = c;
            i++;
        }
        printf("%d", c);
    }
    return 0;
}
--------------------------------------------------------------
output: 34
