#include <stdio.h>
int main()
{
    int a = 0, b = 1, c, n = 10;
    printf("%d %d ", a, b);
    while(n > 2)
    {
        c = a + b;
        printf("%d ", c);
        a = b;
        b = c;
        n--;
    }
    return 0;
}
